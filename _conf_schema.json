{
  "target_group": {
    "description": "接收通知的QQ群号",
    "type": "string",
    "hint": "只支持一个群统一接收所有服务器通知，例如 123456789。",
    "default": ""
  },
  "check_interval": {
    "description": "全局默认检测间隔（秒）",
    "type": "int",
    "hint": "当某台服务器未单独填写检测间隔时，使用这里的值。建议 30-60 秒。",
    "default": 45
  },
  "enable_auto_monitor": {
    "description": "插件加载后自动启动监控",
    "type": "bool",
    "default": true
  },
  "text_enabled": {
    "description": "随图片发送文字详情",
    "type": "bool",
    "hint": "关闭后图片查询/通知只发图片；若图片发送失败会回退发文字。",
    "default": true
  },
  "image_enabled": {
    "description": "启用状态图片生成与发送",
    "type": "bool",
    "hint": "图片只在内存中生成，不保存到本地。",
    "default": true
  },
  "image_theme": {
    "description": "状态图片主题",
    "type": "string",
    "hint": "填写 dark 或 light。",
    "default": "dark"
  },
  "image_scale": {
    "description": "状态图片缩放倍数",
    "type": "int",
    "hint": "建议填写 1-3，数值越大图片越清晰、消息体积也越大。",
    "default": 3
  },
  "image_on_query": {
    "description": "查询时发送状态图片",
    "type": "bool",
    "default": true
  },
  "image_on_change": {
    "description": "状态变化通知时发送状态图片",
    "type": "bool",
    "default": true
  },
  "display": {
    "description": "显示内容开关",
    "type": "object",
    "hint": "控制「/查询」与群通知中每个字段是否展示，默认全部开启。选项名与自建状态接口的字段名一致。",
    "items": {
      "server_name": {
        "description": "显示服务器名称",
        "type": "bool",
        "default": true
      },
      "status": {
        "description": "显示在线状态",
        "type": "bool",
        "default": true
      },
      "address": {
        "description": "显示服务器地址",
        "type": "bool",
        "default": true
      },
      "server_type": {
        "description": "显示服务器类型（Java/基岩）",
        "type": "bool",
        "default": true
      },
      "version": {
        "description": "显示版本",
        "type": "bool",
        "default": true
      },
      "motd": {
        "description": "显示 MOTD",
        "type": "bool",
        "default": true
      },
      "update_time": {
        "description": "显示更新时间",
        "type": "bool",
        "default": true
      },
      "online_count": {
        "description": "显示在线人数",
        "type": "bool",
        "default": true
      },
      "player_list": {
        "description": "显示玩家名单",
        "type": "bool",
        "default": true
      },
      "serverVersion": {
        "description": "显示服务端版本",
        "type": "bool",
        "default": true
      },
      "gameVersion": {
        "description": "显示游戏版本",
        "type": "bool",
        "default": true
      },
      "serverTime": {
        "description": "显示服务器时间",
        "type": "bool",
        "default": true
      },
      "cpuLoad": {
        "description": "显示 CPU 负载",
        "type": "bool",
        "default": true
      },
      "memoryLoad": {
        "description": "显示内存占用",
        "type": "bool",
        "default": true
      },
      "diskSpace": {
        "description": "显示磁盘空间",
        "type": "bool",
        "default": true
      },
      "lastBackup": {
        "description": "显示上次备份时间",
        "type": "bool",
        "default": true
      },
      "loopCount": {
        "description": "显示循环计数",
        "type": "bool",
        "default": true
      },
      "checksum": {
        "description": "显示校验和",
        "type": "bool",
        "default": true
      }
    }
  },
  "server_entries": {
    "description": "多服务器配置列表",
    "type": "template_list",
    "hint": "每一项是一台需要监控的 Minecraft 服务器。",
    "templates": {
      "minecraft_server": {
        "name": "服务器配置项",
        "hint": "添加一台需要监控的 Minecraft 服务器。",
        "items": {
          "server_name": {
            "description": "服务器名称",
            "type": "string",
            "hint": "通知与查询结果中展示的名称；留空时回退为地址。",
            "default": ""
          },
          "server_ip": {
            "description": "服务器地址",
            "type": "string",
            "hint": "支持域名或 IP，例如 play.example.com。",
            "default": ""
          },
          "server_port": {
            "description": "服务器端口",
            "type": "int",
            "default": 25565
          },
          "server_type": {
            "description": "服务器类型",
            "type": "string",
            "hint": "填写 java 或 bedrock。",
            "default": "java"
          },
          "check_interval": {
            "description": "单服务器检测间隔（秒）",
            "type": "int",
            "hint": "填 0 或负数时将自动回退到全局默认值。",
            "default": 45
          },
          "status_api_url": {
            "description": "该服务器自建的状态接口（可选）",
            "type": "string",
            "hint": "填写后查询与通知会附带该接口返回的主机指标；留空则只展示 Minecraft 查询结果。",
            "default": ""
          }
        }
      }
    },
    "default": []
  }
}
